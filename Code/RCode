# 5. Re-scaling factors --------------------------------------------------
# RESCALE PREDICTORS #
rescale_variables <- function (x) {(x - mean(x))/(1*sd (x))}

# Protection levels according to Colombia's National Registry of Protected Areas
coor_loc$plevel_scale <- NA
coor_loc$plevel_scale <- ifelse (coor_loc$pro_level=="not",1,coor_loc$plevel_scale)
coor_loc$plevel_scale <- ifelse (coor_loc$pro_level=="drmi_ctcc",2,coor_loc$plevel_scale)
coor_loc$plevel_scale <- ifelse (coor_loc$pro_level=="pnn",3,coor_loc$plevel_scale)
coor_loc$plevel_scale <- rescale_variables(coor_loc$plevel_scale)

# Human factors (number of fishermen and market distance)
coor_loc$total_fisherman <- as.numeric (coor_loc$total_fisherman) 
coor_loc$nfisherman_scale <- rescale_variables(log(coor_loc$total_fisherman + 1))

coor_loc$distance_market_km <- as.numeric(coor_loc$distance_market_km)
coor_loc$Dmarket_scale    <- rescale_variables(log(coor_loc$distance_market_km+1))

coor_loc$age_scale <- rescale_variables(log(coor_loc$age+1))
colnames(coor_loc)[2] <- "cell_id"

# Testing correlation among human and conservation factors
cor_matrix <- cor (coor_loc[,15:18], method = "pearson")


# 2. Estimating minimal sampling area per location --------------------------
# IMPORTANT
# Sites with smaller sampling area were Amargal and Piedra Oswaldo (250m2)
uvc_sites <-  ddply (db,. (sites, area_uvc), summarize, 
                     num_trans = length (unique (transect_id)))
uvc_sites$area_sampling <- uvc_sites$area_uvc * uvc_sites$num_trans
uvc_sites <- uvc_sites[order(uvc_sites$area_sampling, decreasing = F), ]
min (uvc_sites$area_sampling)

# 3. Estimating fish density and biomass per species ------------------------------
# Biomass estimation (g/m2)
db$weigth <- (db$abun * (db$constant_a * ((db$size_cm*db$tl_correction_multiply)
                                                        ^ db$allometric_coefficient_b)))
db$biomass_gm2 <- db$weigth/db$area

# Density estimation (ind/m2)
db$dens_m2     <- db$abun/db$area 

